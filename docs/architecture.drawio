<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="task-canvas システム構成" id="task-canvas-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="task-canvas システム構成" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Browser -->
        <mxCell id="browser" value="ブラウザ (Client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Frontend -->
        <mxCell id="frontend" value="&lt;b&gt;task-canvas frontend&lt;/b&gt;&lt;br&gt;Next.js (App Router) / :3000&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;BFF: /api/v1/* ・ proxy.ts(認証)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="190" width="360" height="100" as="geometry" />
        </mxCell>

        <!-- Progress -->
        <mxCell id="progress" value="&lt;b&gt;task-canvas-progress&lt;/b&gt;&lt;br&gt;Lit Web Component + Nginx&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;:11000 ・ props駆動、独自API呼び出しなし&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="200" width="320" height="90" as="geometry" />
        </mxCell>

        <!-- Backend -->
        <mxCell id="backend" value="&lt;b&gt;task-canvas backend&lt;/b&gt;&lt;br&gt;Go / Echo / :8080&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;REST /v1/* ・ JWT認証&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="380" width="360" height="100" as="geometry" />
        </mxCell>

        <!-- Postgres (cylinder) -->
        <mxCell id="db" value="PostgreSQL&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;schema: task_canvas&lt;br&gt;user / todo / tag / todo_tag ...&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="580" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Tag manager (planned) -->
        <mxCell id="tagmanager" value="&lt;b&gt;task-canvas-tag-manager&lt;/b&gt;&lt;br&gt;F# / :9090&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tag CRUD API(実装済・未配線)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=13;spacing=6;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="700" y="590" width="260" height="90" as="geometry" />
        </mxCell>

        <!-- Profile (planned) -->
        <mxCell id="profile" value="&lt;b&gt;task-canvas-profile&lt;/b&gt;&lt;br&gt;Java / Wicket&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;プロフィール画面(stale, 2024-11〜)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=13;spacing=6;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1000" y="590" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e-browser-frontend" value="GET / (SSR)&#10;fetch /api/v1/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#333333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-browser-progress" value="直接 &amp;lt;script&amp;gt; 読み込み&#10;(BFFを経由しない)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#D79B00;strokeWidth=2;fontColor=#D79B00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="progress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-frontend-backend" value="REST /v1/* (todos/users/signIn・signUp/verifyAuth)&#10;JWT (httpOnly cookie)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#333333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-backend-db" value="pgx (Postgres protocol)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#333333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-tagmanager-db" value="(未接続)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#999999;strokeWidth=2;dashed=1;fontColor=#999999;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="tagmanager" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-profile-db" value="(未接続)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#999999;strokeWidth=2;dashed=1;fontColor=#999999;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="profile" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="deploy-note" value="デプロイ: ローカル/CI E2E = kamegoro/k8s-infrastructure (Helm + Skaffold)&#10;本番想定 = kamegoro/aws-infrastructure (Terraform: CloudFront/S3, ALB + ECS Fargate, RDS)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1">
