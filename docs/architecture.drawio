<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="task-canvas システム構成" id="task-canvas-arch">
    <mxGraphModel dx="1100" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="task-canvas システム構成" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="16" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="ローカル開発 / CI E2E 環境(kamegoro/k8s-infrastructure)。本番はAWS(kamegoro/aws-infrastructure、ECS Fargate + RDS)上で別途稼働。" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="50" y="48" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="browser" value="ブラウザ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="110" width="180" height="54" as="geometry" />
        </mxCell>

        <mxCell id="k8s" value="Kubernetes Cluster" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#326CE5;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontColor=#326CE5;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="180" y="220" width="740" height="560" as="geometry" />
        </mxCell>

        <mxCell id="webpod" value="task-canvas-web&#10;Next.js :3000" style="aspect=fixed;sketch=0;html=1;dashed=0;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=deploy;fontSize=12;" vertex="1" parent="k8s">
          <mxGeometry x="140" y="60" width="70" height="68" as="geometry" />
        </mxCell>

        <mxCell id="progresspod" value="task-canvas-progress&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;マイクロフロントエンド&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lit + Nginx :11000" style="aspect=fixed;sketch=0;html=1;dashed=0;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=deploy;fontSize=12;" vertex="1" parent="k8s">
          <mxGeometry x="520" y="60" width="70" height="68" as="geometry" />
        </mxCell>

